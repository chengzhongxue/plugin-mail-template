    "eslint-plugin-vue": "^10.10.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "unocss": "^66.9.1",
    "unplugin-icons": "^23.0.1",
