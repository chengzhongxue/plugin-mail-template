    "@halo-dev/ui-shared": "^2.26.0",
    "@lezer/common": "1.5.2",
    "@tanstack/vue-query": "^4.43.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/router": "^14.4.0",
    "axios": "1.20.0",
    "dayjs": "^1.11.23",
    "vue": "3.5.41",
    "vue-codemirror": "^6.1.1",
